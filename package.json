{
  "name": "self-approve-action",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "description": "GitHub Action that approves a pull request when its author is a code owner",
  "author": "ocavue",
  "license": "MIT",
  "homepage": "https://github.com/ocavue/self-approve-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocavue/self-approve-action.git"
  },
  "bugs": {
    "url": "https://github.com/ocavue/self-approve-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run typecheck",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "typecheck": "tsc -b .",
    "fix": "pnpm run build && pnpm run fix:prettier && pnpm run fix:eslint",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier --write .",
    "local-action": "@github/local-action . src/main.ts .env",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@github/local-action": "^7.0.1",
    "@ocavue/eslint-config": "^4.13.5",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
